        { "name": "subject_ref", "path": "subject.reference" },
        { "name": "encounter_ref", "path": "encounter.reference" },
        { "name": "performer_ref", "path": "performer.first().reference" },
        { "name": "effective_datetime", "path": "effectiveDateTime" },
